  "pedagogyZh": {
    "1": {
      "title": "昆雅语音与重音",
      "goal": "掌握元音、辅音、重音规则，能按附录 E 朗读昆雅文本。",
      "mindmap": [
        "音位学",
        "元音长短",
        "辅音与连缀",
        "重音与音节",
        "吠声 H / hl·hr"
      ]
    },
    "2": {
      "title": "名词、复数与定冠词",
      "goal": "理解名词复数 -i/-r、定冠词 i 及无冠词语义。",
      "mindmap": [
        "名词",
        "复数",
        "定冠词 i",
        "词序",
        "练习词汇"
      ]
    },
